# Dockerfile.simulator — Q60 Nav hardware simulator
#
# Strategy (2026-05-14 v2): the Qt VNC platform plugin in our i386 Qt6 build
# is broken — accepts connections but never sends the RFB protocol greeting,
# and doesn't register input devices. Switched to a standard noVNC stack:
#
#   q60nav-amd64 (built with system Qt6 amd64 + xcb plugin)
#     ↓ renders to
#   Xvfb (:99, virtual X11 display)
#     ↓ captured by
#   x11vnc (serves VNC on internal :5900)
#     ↓ bridged by
#   websockify (HTML5 client on :8080)
#
# The simulator binary is a separate amd64 build of q60nav (see
# scripts/build-app-sim.sh) — same QML, same services, but Linux amd64 so
# system Qt6 (with xcb) can host it. MapLibre is disabled in the sim build
# (its static lib is i386-only); the nav screen uses the placeholder grid.
#
# The PRODUCTION binary is still i386 (built via scripts/build-app.sh) for
# the real DCU. The simulator only serves UI testing — not target-arch
# verification.
FROM q60-toolchain

RUN dpkg --add-architecture i386 2>/dev/null || true && \
    apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        # Qt6 amd64 — used by the simulator-only q60nav-amd64 binary.
        # qt6-base-dev pulls in xcb plugin, GL, network, and the core/gui libs.
        qt6-base-dev \
        qt6-base-dev-tools \
        qt6-tools-dev-tools \
        qt6-declarative-dev \
        qt6-declarative-dev-tools \
        qt6-positioning-dev \
        libqt6opengl6-dev \
        qt6-qpa-plugins \
        # QML runtime modules — Ubuntu ships QML modules separately from libqt6qml6.
        # Without these the QML engine fails to load Main.qml with "module not installed".
        qml6-module-qtqml \
        qml6-module-qtqml-models \
        qml6-module-qtqml-workerscript \
        qml6-module-qtquick \
        qml6-module-qtquick-controls \
        qml6-module-qtquick-templates \
        qml6-module-qtquick-layouts \
        qml6-module-qtquick-window \
        qml6-module-qtpositioning \
        # Build deps for amd64 sim build
        libgl1-mesa-dev \
        libegl1-mesa-dev \
        libxkbcommon-dev \
        libfontconfig1-dev \
        libxcb-cursor0 \
        # Xvfb + x11vnc — proven noVNC stack
        xvfb \
        x11vnc \
        # noVNC HTML5 client + websockify WebSocket→TCP bridge
        novnc \
        websockify \
        # Ninja + cmake for the in-container amd64 sim build
        cmake \
        ninja-build \
        # Misc support
        net-tools \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*
