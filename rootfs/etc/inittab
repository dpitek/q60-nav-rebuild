# /etc/inittab — Q60 Nav Rebuild init configuration
# SysV init for Linux 4.19 on Intel Atom E6xx (Crossville Lapis)
# Slot B root: /dev/mmcblk0p3

# Default runlevel (5 = graphical)
id:5:initdefault:

# Boot sequence
si::sysinit:/etc/init.d/rcS

# Runlevel scripts
l0:0:wait:/etc/init.d/rc 0
l1:1:wait:/etc/init.d/rc 1
l2:2:wait:/etc/init.d/rc 2
l3:3:wait:/etc/init.d/rc 3
l4:4:wait:/etc/init.d/rc 4
l5:5:wait:/etc/init.d/rc 5
l6:6:wait:/etc/init.d/rc 6

# Emergency shell (ctrl+alt+del → reboot)
ca::ctrlaltdel:/sbin/reboot -f

# ── Serial / USB console access ──────────────────────────────────────────────
# USB-to-UART adapters plugged into either DCU USB port (FTDI, CP2102, CH341, etc.)
# Plug adapter into DCU USB → connect UART to laptop → open at 115200 8N1
# ttyUSB0 = first adapter detected, ttyUSB1 = second
U0:5:respawn:/sbin/getty -L ttyUSB0 115200 vt100
U1:5:respawn:/sbin/getty -L ttyUSB1 115200 vt100

# UART fallback — ttyS1 (second UART on Atom E6xx; ttyS0 is claimed by GPSD)
# Wire: DCU board UART1 header → USB-to-3.3V-UART dongle → laptop
# Baud may need adjustment depending on BIOS/UEFI default; 115200 typical
S1:5:respawn:/sbin/getty -L ttyS1 115200 vt100

# Watchdog keepalive (runs as separate process, pets /dev/watchdog every 20s)
wd:5:respawn:/opt/nav/watchdog-pet.sh
