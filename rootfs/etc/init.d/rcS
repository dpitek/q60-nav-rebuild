#!/bin/sh
# rcS — Phase 1 Diagnostic Init for Q60 Nav Rebuild on Linux 4.19
# Goal: probe gma500/GMA600, write gate results to /boot/ (FAT32).
# IMPORTANT: must not exit non-zero. Every fallible op uses || true.

STAGE=/tmp/q60_stages.log
ts() { date '+%H:%M:%S' 2>/dev/null || echo '?'; }
log() { echo "[$1] $(ts) $2" >> "$STAGE"; echo "[$1] $2" 2>/dev/null || true; }

# ── Stage 1: Essential virtual filesystems ────────────────────────────────
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
# DEVTMPFS_MOUNT=y means kernel pre-populates /dev before init — skip if so
mountpoint -q /dev 2>/dev/null || mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t tmpfs -o nosuid,nodev,size=32M,mode=755 tmpfs /run 2>/dev/null || true
mount -t tmpfs -o nosuid,nodev,size=64M tmpfs /tmp 2>/dev/null || true
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts 2>/dev/null || true
log S1 "filesystems mounted"

# ── Stage 2: Boot partition mount (FAT32 → /boot) ────────────────────────
# SD card may appear as mmcblk0, mmcblk1, or mmcblk2 depending on eMMC probe order.
# Try p1 on each MMC device; mount whichever FAT32 partition answers first.
BOOT_DEV=""
i=0
while [ $i -lt 15 ]; do
    for dev in /dev/mmcblk0p1 /dev/mmcblk1p1 /dev/mmcblk2p1; do
        if [ -b "$dev" ]; then
            mount -t vfat -o rw,relatime "$dev" /boot 2>/dev/null && \
                mountpoint -q /boot 2>/dev/null && { BOOT_DEV="$dev"; break 2; }
        fi
    done
    sleep 1
    i=$((i+1))
done
[ -n "$BOOT_DEV" ] && log S2 "boot mounted from $BOOT_DEV after ${i}s" || log S2 "CRITICAL: /boot mount FAILED — tried mmcblk0-2p1 for ${i}s"

# ── Stage 3: IMMEDIATELY restore elilo.conf to default=logan1 ────────────
# First priority — ensures car recovers even if rest of rcS panics
if mountpoint -q /boot 2>/dev/null; then
    sed -i 's/^default=.*/default=logan1/' /boot/elilo.conf 2>/dev/null || true
    sync 2>/dev/null || true
    log S3 "elilo.conf restored: default=logan1"
else
    log S3 "CRITICAL: /boot not mounted — elilo.conf NOT restored, car will loop!"
fi

# ── Stage 4: Boot counter and watchdog ───────────────────────────────────
rm -f /boot/q60_boot_attempts 2>/dev/null || true
# Magic-close any BIOS-pre-armed hardware watchdog
if [ -e /dev/watchdog ]; then
    printf 'V' > /dev/watchdog 2>/dev/null || true
    log S4 "watchdog magic-close sent"
else
    log S4 "no /dev/watchdog (expected for diagnostic)"
fi

# ── Stage 5: Hardware inventory (before DRM probe) ───────────────────────
{
    echo "=== Q60 Phase 1 Hardware Inventory ==="
    echo "Date: $(date 2>/dev/null)"
    echo "Cmdline: $(cat /proc/cmdline 2>/dev/null)"
    echo ""
    echo "--- CPU ---"
    grep -E "model name|cpu MHz|siblings|cpu cores" /proc/cpuinfo 2>/dev/null | head -8
    echo ""
    echo "--- PCI devices ---"
    for d in /sys/bus/pci/devices/*/; do
        id=$(cat "${d}vendor" 2>/dev/null | tr -d '0x'):$(cat "${d}device" 2>/dev/null | tr -d '0x')
        cls=$(cat "${d}class" 2>/dev/null)
        drv=$(basename "$(readlink ${d}driver 2>/dev/null)" 2>/dev/null || echo "(none)")
        echo "  $(basename $d)  id=$id  class=$cls  driver=$drv"
    done
    echo ""
    echo "--- Block devices ---"
    cat /proc/partitions 2>/dev/null
    echo ""
    echo "--- Memory ---"
    cat /proc/meminfo 2>/dev/null | head -10
} > /tmp/q60_inventory.log 2>&1
log S5 "inventory captured"

# ── Stage 6: Pre-probe dmesg ──────────────────────────────────────────────
dmesg 2>/dev/null > /tmp/q60_dmesg_pre.log || true
log S6 "pre-probe dmesg: $(wc -l < /tmp/q60_dmesg_pre.log 2>/dev/null || echo '?') lines"

# ── Stage 7: Wait for gma500 / /dev/fb0 ──────────────────────────────────
# devtmpfs (CONFIG_DEVTMPFS_MOUNT=y) pre-populates /dev; mdev -s re-scans.
# udevd is NOT in the busybox image — use mdev only.
echo /bin/mdev > /proc/sys/kernel/hotplug 2>/dev/null || true
mdev -s 2>/dev/null || true

i=0
while [ $i -lt 10 ]; do
    [ -e /dev/fb0 ] && break
    sleep 1
    i=$((i+1))
done
log S7 "fb0 wait: $([ -e /dev/fb0 ] && echo "EXISTS (after ${i}s)" || echo "ABSENT after 10s")"

# ── Stage 8: DRM/gma500 state probe ──────────────────────────────────────
{
    echo "=== Q60 DRM/GMA500 State ==="
    echo "Date: $(date 2>/dev/null)"
    echo ""
    echo "--- Framebuffer devices ---"
    ls -la /dev/fb* 2>/dev/null || echo "(none)"
    cat /proc/fb 2>/dev/null || echo "(no /proc/fb)"
    echo ""
    echo "--- gma500 driver binding ---"
    if [ -d /sys/bus/pci/drivers/gma500 ]; then
        echo "gma500 driver exists"
        ls /sys/bus/pci/drivers/gma500/ 2>/dev/null
        for dev in /sys/bus/pci/drivers/gma500/*/; do
            [ -d "$dev" ] || continue
            echo "  bound: $(basename $dev)"
            cat "${dev}uevent" 2>/dev/null
        done
    else
        echo "(gma500 driver not registered — driver did not probe or returned error)"
    fi
    echo ""
    echo "--- DRM class ---"
    ls -la /sys/class/drm/ 2>/dev/null || echo "(no DRM class)"
    echo ""
    echo "--- gma500/drm dmesg ---"
    dmesg 2>/dev/null | grep -iE "gma500|psb|oaktrail|4108|GMA600|LVDS|drm|fb0|framebuffer" | head -80
} > /tmp/q60_drm_state.log 2>&1
log S8 "DRM state captured"

# ── Stage 9: Gate determination ───────────────────────────────────────────
FB_OK=0
GMA_BOUND=0
[ -e /dev/fb0 ] && FB_OK=1
[ -d /sys/bus/pci/drivers/gma500 ] && \
    ls /sys/bus/pci/drivers/gma500/ 2>/dev/null | grep -q ":" && GMA_BOUND=1

if [ "$FB_OK" -eq 1 ] && [ "$GMA_BOUND" -eq 1 ]; then
    GATE="PASS"
    DETAIL="gma500 bound to GMA600 (PCI 8086:4108) and /dev/fb0 exists"
elif [ "$GMA_BOUND" -eq 1 ]; then
    GATE="PARTIAL"
    DETAIL="gma500 bound but /dev/fb0 absent — modeset may have failed"
elif [ "$FB_OK" -eq 1 ]; then
    GATE="PARTIAL"
    DETAIL="/dev/fb0 exists but no gma500 binding — may be efifb or vesa"
else
    GATE="FAIL"
    DETAIL="gma500 not bound and /dev/fb0 absent"
fi
log S9 "GATE=$GATE $DETAIL"

# ── Stage 10: Post-probe dmesg ────────────────────────────────────────────
dmesg 2>/dev/null > /tmp/q60_dmesg_post.log || true
log S10 "post-probe dmesg: $(wc -l < /tmp/q60_dmesg_post.log 2>/dev/null || echo '?') lines"

# ── Stage 11: Write all results to /boot/ ────────────────────────────────
if mountpoint -q /boot 2>/dev/null; then
    printf "Q60 PHASE 1 DISPLAY GATE: %s\n%s\nDate: %s\n" \
        "$GATE" "$DETAIL" "$(date 2>/dev/null)" > /boot/Q60_DISPLAY_GATE.TXT
    sync 2>/dev/null || true

    cp /tmp/q60_drm_state.log  /boot/Q60_DRM_STATE.LOG      2>/dev/null || true
    cp /tmp/q60_dmesg_post.log /boot/Q60_DMESG_POST_GFX.LOG 2>/dev/null || true
    cp /tmp/q60_inventory.log  /boot/Q60_INVENTORY.LOG       2>/dev/null || true
    sync 2>/dev/null || true

    log S11 "LOGS WRITTEN: gate=$GATE"
    cat "$STAGE" >> /boot/Q60_DIAG_STAGES.LOG 2>/dev/null || true
    echo "[S11] $(ts) ALL DONE — gate=$GATE" >> /boot/Q60_DIAG_STAGES.LOG
    sync 2>/dev/null || true
else
    log S11 "CRITICAL: /boot not mounted — no logs written to SD card!"
fi

echo "[rcS] Phase 1 complete. Gate=$GATE Syncing and halting."
sync 2>/dev/null || true
# Halt so car doesn't loop; default=logan1 already restored above
halt -f 2>/dev/null || poweroff -f 2>/dev/null || true

exit 0
