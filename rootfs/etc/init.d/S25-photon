#!/bin/sh
# S25-photon — Start Photon offline geocoder (komoot/photon)
# Runs before Weston (S30) so geocoder is ready when the nav app starts.
# Photon exposes a Pelias-compatible REST API on 127.0.0.1:4000.
#
# Requires:
#   /opt/photon/photon.jar    — Photon JAR (see scripts/download-photon.sh)
#   /opt/photon/photon_data/  — Indexed NC region data
#   Java 11+ headless JRE     — must be installed at /usr/bin/java
#     (TODO: install openjdk-11-jre-headless:i386 into rootfs)
#     (see rootfs/etc/profile.d/java-todo.txt for details)
#
# If Java or the JAR is missing, logs a warning and exits 0 — nav app
# operates without geocoder (search will fail gracefully on its own).

JAR=/opt/photon/photon.jar
DATA_DIR=/opt/photon/photon_data
JAVA=/usr/bin/java
LOG=/var/log/photon.log
PIDFILE=/var/run/photon.pid
LISTEN_IP=127.0.0.1
LISTEN_PORT=4000
READY_TIMEOUT=15   # seconds to wait for port 4000 before declaring ready

# ── Helpers ──────────────────────────────────────────────────────────────────

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOG"
}

port_open() {
    # Use /dev/tcp if bash is available, otherwise fall back to nc
    if command -v nc >/dev/null 2>&1; then
        nc -z "$LISTEN_IP" "$LISTEN_PORT" >/dev/null 2>&1
    else
        # bash /dev/tcp trick — works on BusyBox bash builds
        (echo > /dev/tcp/"$LISTEN_IP"/"$LISTEN_PORT") >/dev/null 2>&1
    fi
}

wait_for_port() {
    i=0
    while [ "$i" -lt "$READY_TIMEOUT" ]; do
        port_open && return 0
        sleep 1
        i=$((i + 1))
    done
    return 1
}

# ── Actions ───────────────────────────────────────────────────────────────────

case "$1" in
start)
    log "Starting Photon geocoder..."

    # Graceful bail-outs — nav works without geocoder
    if [ ! -x "$JAVA" ]; then
        log "WARNING: Java not found at $JAVA — geocoder unavailable (install openjdk-11-jre-headless:i386)"
        exit 0
    fi

    if [ ! -f "$JAR" ]; then
        log "WARNING: $JAR not found — geocoder unavailable (run scripts/download-photon.sh)"
        exit 0
    fi

    if [ ! -d "$DATA_DIR" ]; then
        log "WARNING: $DATA_DIR not found — geocoder unavailable (run scripts/download-photon.sh)"
        exit 0
    fi

    # Prevent double-start
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        log "Photon already running (PID $(cat "$PIDFILE"))"
        exit 0
    fi

    "$JAVA" -Xms128m -Xmx512m -jar "$JAR" \
        --listen-ip "$LISTEN_IP" \
        --listen-port "$LISTEN_PORT" \
        --data-dir "$DATA_DIR" \
        >> "$LOG" 2>&1 &

    echo $! > "$PIDFILE"
    log "Photon started (PID $!) — waiting up to ${READY_TIMEOUT}s for port ${LISTEN_PORT}..."

    if wait_for_port; then
        log "Photon ready on ${LISTEN_IP}:${LISTEN_PORT} (PID $(cat "$PIDFILE"))"
    else
        log "WARNING: Photon did not respond within ${READY_TIMEOUT}s — nav will continue without geocoder"
    fi
    ;;

stop)
    log "Stopping Photon..."
    if [ -f "$PIDFILE" ]; then
        PID=$(cat "$PIDFILE")
        if kill "$PID" 2>/dev/null; then
            # Wait up to 5s for clean shutdown
            i=0
            while kill -0 "$PID" 2>/dev/null && [ "$i" -lt 5 ]; do
                sleep 1
                i=$((i + 1))
            done
            kill -9 "$PID" 2>/dev/null || true
            log "Photon stopped"
        else
            log "Photon was not running"
        fi
        rm -f "$PIDFILE"
    else
        log "Photon not running (no PID file)"
    fi
    ;;

restart)
    "$0" stop
    "$0" start
    ;;

status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "Photon running (PID $(cat "$PIDFILE"))"
        port_open && echo "Port ${LISTEN_PORT}: open" || echo "Port ${LISTEN_PORT}: not responding"
    else
        echo "Photon stopped"
    fi
    ;;

*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
