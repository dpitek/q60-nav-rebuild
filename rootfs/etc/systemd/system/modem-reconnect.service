[Unit]
Description=Q60 LTE Reconnect Watch
After=modem-connect.service

[Service]
Type=simple
# Re-run connect script if connectivity drops for >60s.
# Uses DHCP gateway probe — no external IP address required.
ExecStart=/bin/sh -c '\
  while true; do \
    sleep 60; \
    GW=$(ip route | awk '"'"'/default/ {print $3; exit}'"'"'); \
    if [ -z "$GW" ] || ! ping -c 1 -W 5 "$GW" > /dev/null 2>&1; then \
      logger -t q60-modem "Connectivity lost — reconnecting..."; \
      /opt/nav/bin/modem-connect.sh; \
    fi; \
  done'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
