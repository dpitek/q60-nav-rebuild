[Unit]
Description=Q60 LTE Reconnect Watch
After=modem-connect.service

[Service]
Type=simple
# Re-run connect script if connectivity drops for >60s
ExecStart=/bin/sh -c '\
  while true; do \
    sleep 60; \
    if ! ping -c 1 -W 5 8.8.8.8 > /dev/null 2>&1; then \
      logger -t q60-modem "Connectivity lost — reconnecting..."; \
      /opt/nav/bin/modem-connect.sh; \
    fi; \
  done'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
