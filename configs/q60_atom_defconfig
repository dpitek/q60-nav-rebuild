# Q60 Nav Rebuild — Linux 4.19 LTS
# Target: Intel Atom E6xx (Bonnell), i686, 32-bit
# Board: Clarion QY5092 DCU

#
# Base architecture
#
CONFIG_X86_32=y
CONFIG_X86=y
CONFIG_GENERIC_CPU=n
CONFIG_MATOMIC=y
CONFIG_X86_INTEL_USERCOPY=y
CONFIG_X86_USE_PPRO_CHECKSUM=y

#
# Processor family — Bonnell (Atom E6xx)
#
CONFIG_MATOM=y
CONFIG_X86_L1_CACHE_SHIFT=6
CONFIG_SMP=n
CONFIG_NR_CPUS=2

#
# Memory
#
CONFIG_HIGHMEM64G=n
CONFIG_HIGHMEM4G=y
CONFIG_NOHIGHMEM=n
CONFIG_PAGE_OFFSET=0xC0000000
CONFIG_PHYSICAL_START=0x100000
CONFIG_VMSPLIT_3G=y

#
# Timers
#
CONFIG_HZ_250=y
CONFIG_HZ=250
CONFIG_HPET_TIMER=y
CONFIG_HPET_EMULATE_RTC=y

#
# Boot
#
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_VARS=y
CONFIG_EFIVAR_FS=y

#
# Block layer
#
CONFIG_BLOCK=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=n
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y

#
# Filesystems
#
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_OVERLAY_FS=y

#
# Display — Intel GMA 600 (Poulsbo/Lincroft PowerVR SGX535)
# Software rendering only — no PowerVR kernel driver
# Use simple-framebuffer or VESA for console
#
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y

#
# Input
#
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_ATMEL_MXT=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y

#
# Serial / UART
#
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

#
# USB
#
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_SERIAL=y
CONFIG_USB_ACM=y

#
# Audio — Intel HD Audio / SST
#
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_SOC=y

#
# CAN bus — SocketCAN
#
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_BCM=y
CONFIG_CAN_GW=y
CONFIG_CAN_DEV=y
CONFIG_CAN_PEAK_PCI=y

#
# Networking
#
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=n
CONFIG_NETFILTER=y

#
# Bluetooth
#
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIUART=y

#
# WiFi (for OTA updates via hotspot)
#
CONFIG_CFG80211=y
CONFIG_WIRELESS=y
CONFIG_MAC80211=y

#
# I2C (touchscreen, EDID read)
#
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_PCI=y

#
# GPIO / SPI
#
CONFIG_GPIOLIB=y
CONFIG_GPIO_SYSFS=y
CONFIG_SPI=y

#
# Power management
#
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_ACPI=y
CONFIG_ACPI_SLEEP=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_X86_ACPI_CPUFREQ=y

#
# Watchdog
#
CONFIG_WATCHDOG=y
CONFIG_iTCO_WDT=y

#
# Kernel features
#
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUTEX=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX_DIAG=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

#
# Security
#
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECCOMP=y

#
# Debugging (disable for production)
#
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_DEBUG_KERNEL=n
CONFIG_MAGIC_SYSRQ=n
