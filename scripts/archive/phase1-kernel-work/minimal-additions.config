# minimal-additions.config — overlay on top of `make tinyconfig` for Q60 Test C
#
# Goal: smallest possible bzImage that
#   1. loads via UEFI EFI stub on Tunnel Creek (Insyde EFI on BLDK 2.3.6.7)
#   2. decompresses successfully on Bonnell (no MOVBE)
#   3. unpacks embedded initramfs
#   4. runs /init from initramfs
#   5. writes "REACHED USERSPACE" to ramoops + powers off
#
# Everything not strictly required for the above is OFF.

# ── Atom Bonnell CPU — i686 baseline, NO MOVBE ──
CONFIG_M686=y
# CONFIG_MATOM is not set
CONFIG_X86_GENERIC=y
CONFIG_HIGHMEM64G=y
CONFIG_X86_PAE=y

# ── EFI stub + Handover Protocol ──
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_RELOCATABLE=y
# Note: CONFIG_EFI_HANDOVER_PROTOCOL doesn't exist as a kconfig in 4.19; the
# handover xloadflags are unconditionally set when EFI_STUB=y in this version.
# (Newer kernels split this out; 4.19 has it baked.)

# ── Kernel compression — XZ for small bzImage ──
CONFIG_KERNEL_XZ=y
# CONFIG_KERNEL_GZIP is not set

# ── Embedded initramfs ──
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/k-output/initramfs.cpio.gz"
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_RD_GZIP=y

# ── Cmdline embedded (defense if bootloader passes nothing) ──
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="init=/init console=ttyPCH0,115200n8 console=ttyS0,115200n8 loglevel=8 ignore_loglevel idle=halt panic=10 mem=1G nokaslr ramoops.mem_address=0x3400000 ramoops.mem_size=0x100000 printk.devkmsg=on printk.always_kmsg_dump=1"

# ── pstore + ramoops — only persistent-evidence path we have ──
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_DEFLATE_COMPRESS=y
CONFIG_PSTORE_COMPRESS=y
CONFIG_PSTORE_COMPRESS_DEFAULT="deflate"

# ── Console output: PCH UART (matches factory ttyPCH0) + serial 8250 ──
CONFIG_SERIAL_PCH_UART=y
CONFIG_SERIAL_PCH_UART_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

# ── ELF binaries + procfs/sysfs basics ──
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TTY=y

# ── ACPI (Tunnel Creek is ACPI-based, not SFI/MID) ──
CONFIG_ACPI=y
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y

# ── PCI (needed for ALL Tunnel Creek + LAPIS device enumeration) ──
CONFIG_PCI=y
CONFIG_PCI_MMCONFIG=y

# ── MMC + LAPIS SDHCI patch (for completeness — initramfs makes it optional) ──
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_PCH_PHUB=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_PARTITION_ADVANCED=y

# ── Block layer ──
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y

# ── Disable everything else explicitly we don't need ──
# CONFIG_NET is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_VT is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_HID is not set
# CONFIG_INPUT is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_INTEL_IDLE is not set
# CONFIG_X86_INTEL_MID is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_MD is not set
# CONFIG_BT is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_RFKILL is not set
